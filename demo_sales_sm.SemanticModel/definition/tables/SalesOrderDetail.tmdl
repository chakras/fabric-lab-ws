		formatString: 0
		sourceProviderType: int
		lineageTag: 302af7f5-0f28-4c79-ac44-3abee775bae9
		sourceLineageTag: SpecialOfferID
		summarizeBy: count
		sourceColumn: SpecialOfferID

		annotation SummarizationSetBy = Automatic

