/// **Business purpose:** Stores sales representative performance and compensation details, including territory assignment, quota, bonus, commission rate, and sales results.
/// 
/// **Expected grain:** One row per sales person. Use key columns like BusinessEntityID as unique identifiers only; do not aggregate. Sum or average numeric measures such as SalesQuota, Bonus, CommissionPct, SalesYTD, and SalesLastYear as appropriate.
/// 
/// **Reporting usage:** Used for sales performance, quota attainment, compensation analysis, territory reporting, and year-over-year sales comparisons.
table SalesPerson
	lineageTag: c07ca908-deec-472e-b13b-27bd42ab4cea
	sourceLineageTag: [dbo].[SalesPerson]

	/// Unique identifier for each salesperson in the business system. Use this key to relate salesperson records to related tables and to identify a specific salesperson. Do not summarize or aggregate this column; it should be treated as an identifier only.
	column BusinessEntityID
		dataType: int64
		formatString: 0
		sourceProviderType: int
		lineageTag: 8eb80635-97a3-4f23-acad-2f659cfd5f3e
		sourceLineageTag: BusinessEntityID
		summarizeBy: none
		sourceColumn: BusinessEntityID

		annotation SummarizationSetBy = Automatic

	/// Business identifier for the sales territory assigned to a salesperson. Use this field to relate salespeople to territory records and analyze performance by territory. Do not sum or average; treat as a key or grouping field only.
	column TerritoryID
		dataType: int64
		formatString: 0
		sourceProviderType: int
		lineageTag: 6e2ee8d5-9691-4c9d-8986-a447680db2c4
		sourceLineageTag: TerritoryID
		summarizeBy: count
		sourceColumn: TerritoryID

		annotation SummarizationSetBy = Automatic

	/// Planned sales target assigned to each sales person for a period. Use this field to compare actual sales performance against goals and track quota attainment. Summarize only as appropriate for analysis, such as sum or average across sales people, not as a unique identifier.
	column SalesQuota
		dataType: double
		sourceProviderType: decimal(19, 4)
		lineageTag: f653e28a-32ac-4581-a184-b4dd57eecd73
		sourceLineageTag: SalesQuota
		summarizeBy: sum
		sourceColumn: SalesQuota

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Bonus amount awarded to the salesperson as additional compensation based on performance or achievement. Use this field to analyze incentive pay, compensation trends, and sales rewards. Summarize as **Sum** for total bonus reporting; avoid averaging unless comparing typical bonus levels.
	column Bonus
		dataType: double
		sourceProviderType: decimal(19, 4)
		lineageTag: 9186827d-4d4e-4490-a20a-76d0712f534a
		sourceLineageTag: Bonus
		summarizeBy: sum
		sourceColumn: Bonus

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// CommissionPct shows the sales commission percentage earned by each salesperson. Use it to analyze compensation, incentive performance, and margin impact. Summarize as an average or weighted average for reporting; do not sum percentages unless evaluating total rate assumptions.
	column CommissionPct
		dataType: decimal
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		sourceProviderType: decimal(10, 4)
		lineageTag: 5e3202d4-4935-49bf-af06-a3f0cc0fa382
		sourceLineageTag: CommissionPct
		summarizeBy: sum
		sourceColumn: CommissionPct

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Year-to-date sales amount generated by each salesperson. Use this measure to compare individual sales performance and track progress against targets over the current year. Summarize as **Sum** for team or period analysis; do not use as a key or identifier.
	column SalesYTD
		dataType: double
		sourceProviderType: decimal(19, 4)
		lineageTag: ee3e4119-c55d-446f-90f1-575767fbd57b
		sourceLineageTag: SalesYTD
		summarizeBy: sum
		sourceColumn: SalesYTD

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Total sales amount generated by this salesperson in the previous fiscal year. Use this measure to compare historical performance, rank salespeople, and analyze trends over time. Summarize as **Sum** for totals or **Average** for per-person analysis; do not count this field.
	column SalesLastYear
