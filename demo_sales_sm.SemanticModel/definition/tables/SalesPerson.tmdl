		sourceProviderType: decimal(19, 4)
		lineageTag: 46a32ff1-9c40-4c11-b19c-96f304f3aa25
		sourceLineageTag: SalesLastYear
		summarizeBy: sum
		sourceColumn: SalesLastYear

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Unique identifier for each salesperson record. Used to distinctly track and relate this salesperson across business systems and reports. Do not summarize or aggregate this field; use only as a key for lookup and row-level identification.
	column rowguid
